{:paths ["src"]
 :deps  {org.clojure/clojure {:mvn/version "1.10.3"}}

 :donut/lib {:name           party.donut/compose
             :description    "compose data"
             :github         "donut-party/compose"
             :version-prefix "0.0"}

 :aliases
 {:dev
  {:extra-deps  {org.clojure/clojure {:mvn/version "1.10.3"}}
   :extra-paths ["dev" "test"]}

  :test
  {:extra-paths ["test"]
   :extra-deps  {org.clojure/clojure                  {:mvn/version "1.10.3"}
                 io.github.cognitect-labs/test-runner {:git/tag "v0.5.0" :git/sha "48c3c67"}}
   :exec-fn     cognitect.test-runner.api/test}

  :test-cljs
  {:extra-paths ["test"]
   :extra-deps  {org.clojure/clojure     {:mvn/version "1.10.3"}
                 org.clojure/test.check  {:mvn/version "0.9.0"}
                 olical/cljs-test-runner {:mvn/version "3.8.0"}}
   :exec-fn     cljs-test-runner.main/-main}


  :build
  {:deps       {io.github.donut-party/framework-build
                {:git/sha "912e0b0ffc914cf1b5824650268307062d92e40c"}}
   :ns-default donut.build}}}
